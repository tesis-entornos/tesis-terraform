# Directorios locales de Terraform
.terraform/
.terraform.tfstate.lock.info

# State
*.tfstate
*.tfstate.*

# Planes guardados (pueden contener valores sensibles)
*.tfplan
*.tfplan.*
tfplan

# Variables: values*.tfvars se versionan (configuración no sensible por capa/modelo).
# Cualquier otro .tfvars queda local (por ejemplo, uno con secretos).
*.tfvars
!values*.tfvars
!*.tfvars.example

# Logs de crash
crash.log
crash.*.log

# Overrides locales
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# .terraform.lock.hcl SÍ se versiona (no ignorar)
